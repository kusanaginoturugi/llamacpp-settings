# ~/.config/llama.cpp/llama.env に置く、PC ごとに違う llama-server の設定（systemd の EnvironmentFile）。
#
# llama-server を呼べるオリジン。Firefox 拡張（offline-browser-translate）の ID は PC（プロファイル）ごとに違う。
# about:debugging#/runtime/this-firefox の「内部 UUID」で見られる。複数あるときはカンマで区切る
LLAMA_ARG_CORS_ORIGINS=moz-extension://00000000-0000-0000-0000-000000000000
